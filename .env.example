# Modèle de configuration locale KYRAN — copier en .env (ignoré par git)
# Ne jamais mettre de vraie valeur secrète dans CE fichier : il est public.

# Clé PUBLIQUE Stripe (publiable, sans risque)
STRIPE_PUBLIC_KEY=pk_live_51UBHzpPe2ed8eDFCLWitUrUCiODYAkhUGficIbsYdpBjhfUSMPSFxxcFMomkexlykk9bXc99ofxXasmGfbiSnRJG00ORucyBmB
# Clé secrète Stripe : préférer une clé restreinte (rk_live_…) limitée aux webhooks
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK=https://buy.stripe.com/eVqeVfaWz4k02yY1UqaEE00

# Secret de signature du webhook Stripe (whsec_…) — obligatoire côté serveur/Worker
STRIPE_WEBHOOK_SECRET=

# Token d'administration (32 caractères minimum) pour admin-emails.html et les scripts
# send-client-email / send-shipping-email. Générer avec : openssl rand -base64 36
ADMIN_SECRET=

# Envoi d'emails (Option A : Resend API / Option B : SMTP OVH)
RESEND_API_KEY=
OVH_SMTP_PASSWORD=

# Serveur (Railway)
ADMIN_NOTIFICATION_EMAILS=contact@kyran-jeu.fr
ALLOWED_ORIGINS=https://kyran-jeu.fr,https://www.kyran-jeu.fr

# Instagram (page /communaute.html) — jeton longue durée de l'API Instagram, voir docs/INSTAGRAM.md
# En production : secret GitHub « INSTAGRAM_ACCESS_TOKEN » (workflow instagram.yml)
INSTAGRAM_ACCESS_TOKEN=
# Facultatif : uniquement pour l'API « Facebook Login » (graph.facebook.com)
INSTAGRAM_USER_ID=
