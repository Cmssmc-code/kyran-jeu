{
  "mcpServers": {
    "gsc": {
      "command": "node",
      "args": [
        "scripts/mcp/gsc.mjs"
      ],
      "type": "stdio"
    },
    "bing-webmaster": {
      "command": "node",
      "args": [
        "scripts/mcp/bing.mjs"
      ],
      "type": "stdio"
    },
    "stripe-kyran": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp@0.3.3",
        "--api-key=${STRIPE_SECRET_KEY}"
      ],
      "env": {}
    }
  }
}